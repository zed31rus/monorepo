<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\Openapi</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name v1</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Scalar.AspNetCore" />
        <ProjectReference Include="$(RepoRoot)Apps\Authorization\Core\Core.csproj" />
        <ProjectReference Include="$(RepoRoot)Options\Auth\Auth.csproj"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server"/>
        <ProjectReference Include="$(RepoRoot)Options\Global\Global.csproj" />
        <ProjectReference Include="$(RepoRoot)Packages\Infra\Infra.csproj"/>
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Openapi\" />
    </ItemGroup>

    <Target Name="GenerateKiotaClient" AfterTargets="GenerateOpenApiDocuments">
        <PropertyGroup>
            <OpenApiJsonPath>$(OpenApiDocumentsDirectory)\v1.json</OpenApiJsonPath>
            <ClientOutputDir>$(RepoRoot)Packages\Infra\Clients\Generated</ClientOutputDir>
        </PropertyGroup>

        <Exec Command="kiota generate -l CSharp -d $(OpenApiJsonPath) -o $(ClientOutputDir) --namespace-name zed31rus.Infra.Clients.Auth --class-name AuthHttpClient --clean-output" />
    </Target>
</Project>
