<Project Sdk="Microsoft.NET.Sdk">
    
    <PropertyGroup>
        <AssemblyName>AuthorizationCore</AssemblyName>
        <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\openapi</OpenApiDocumentsDirectory>
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Identity.Core" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
        <PackageReference Include="Scrutor" />
        <ProjectReference Include="$(RepoRoot)Packages/Db/Auth/AuthDb.csproj" />
        <ProjectReference Include="$(RepoRoot)Packages/Libs/Libs.csproj" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <ProjectReference Include="$(RepoRoot)Shared/Shared.csproj" />
        <ProjectReference Include="$(RepoRoot)Options/Auth/Auth.csproj" />
    </ItemGroup>
</Project>
